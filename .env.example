APP_NAME=Skular
# Production: APP_ENV=production, APP_DEBUG=false, APP_URL=https://your-domain.example
# Generate APP_KEY once per deployment: php artisan key:generate --show
# Do not rotate APP_KEY on routine deploys; existing encrypted data would become unreadable.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Canonical public host for canonical tags, sitemap and social previews.
# Empty means "reuse APP_URL"; a loopback host falls back to https://skularship.com.
SEO_CANONICAL_URL=

# Optional sitemap lastmod overrides (Y-m-d). Defaults live in config/seo.php;
# change them only when the landing/FAQ copy really changes, not on deploy.
# SEO_HOME_LASTMOD=
# SEO_FAQ_LASTMOD=

# Optional comma-separated official social profile URLs for Organization.sameAs.
# Default: https://www.instagram.com/skulars
# SEO_SAME_AS=

# Comma-separated IPs of a reverse proxy/load balancer (or "*" only when the
# origin is unreachable except through that proxy). Leave empty when direct.
TRUSTED_PROXIES=

# Optional. true shows the "Skular sedang diperbarui" page (503) on public and mentee
# pages; admin, health, legal pages and the Midtrans webhook keep working.
# Run `php artisan optimize` after changing it (config and routes are cached).
# UNDER_CONSTRUCTION=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Observability (no request bodies, bindings, or mentee content are logged).
PERFORMANCE_LOG_SLOW_REQUESTS=true
PERFORMANCE_SLOW_REQUEST_MS=1000
PERFORMANCE_LOG_SLOW_QUERIES=false
PERFORMANCE_SLOW_QUERY_MS=200

# AI (laravel/ai, driver openrouter). The text model is fixed in config/ai.php;
# there is no env variable for it. Tests fake the AI and need no key.
OPENROUTER_API_KEY=
# AI Mentor questions sent to the model per mentee per module (default 5).
AI_MODULE_CHAT_LIMIT=5
# Try Out: mentor questions per attempt (Pro).
# TRYOUT_MENTOR_LIMIT=10

# Optional. Leave commented to use the default (an empty value would override it).
# PASSKEYS_USER_HANDLE_SECRET=        # defaults to APP_KEY
# BLAZE_ENABLED=true                  # set false only to debug Blade components, then php artisan view:clear
# ANALYTICS_PROPERTY_ID=              # Google Analytics 4 property for the admin dashboard;
#                                     # credentials file: storage/app/analytics/service-account-credentials.json

# GA4 tracking tag on public pages, production only. Format G-XXXXXXXXXX (Web data stream
# measurement ID); not the numeric ANALYTICS_PROPERTY_ID read by the admin dashboard.
GA_MEASUREMENT_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional: WhatsApp help line on the "Bantuan" page (digits only, country code first).
# SUPPORT_WHATSAPP_NUMBER=6289604883024

# Local development uses SQLite. Production should use MySQL 8+ or PostgreSQL 15+.
# The SQLite file is created by `composer setup`; never point production at it.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=skular
DB_USERNAME=skular
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true when the site is served over HTTPS, so cookies are never sent in clear text.
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
# Private proofs/practice uploads are written to storage/app/private. Mount that
# directory on persistent storage in production; object storage needs an adapter.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Payment notifications (queue "payments") and reminder emails (queue "reminders") run on the queue.
# Production needs a worker kept alive by Supervisor: php artisan queue:work --queue=payments,reminders,default
# and the scheduler: * * * * * php artisan schedule:run   (daily reminders, requeue of stuck payments).
# AI practice evaluation still runs inside the web request.
# DB_QUEUE_RETRY_AFTER=150

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Reminder emails (deadline and Pro ending) use these. MAIL_MAILER=log only writes to the log, so set a real mailer
# (smtp, ses, resend, ...) and a real MAIL_FROM_ADDRESS before turning Premium on.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Premium (payments, Pro features). Everything below is off or empty by default.
# Go-live checklist, in order:
#   1. Fill Sandbox keys, set the Midtrans notification URL in the Midtrans dashboard (Settings > Payment >
#      Notification URL) to: ${APP_URL}/payments/midtrans/notification
#   2. Make sure a queue worker and the scheduler run (see QUEUE_CONNECTION above) and MAIL_* is real.
#   3. Run the role seeder so admins get the payment permissions: php artisan db:seed --class=RoleSeeder
#   4. Test a Sandbox payment end to end, then swap to production keys and MIDTRANS_IS_PRODUCTION=true.
#   5. Fill the LEGAL_* values below and make sure `php artisan legal:check` passes in production
#      (it fails while a legal page still shows an [ISI: ...] or [KEPUTUSAN ...] marker).
#   6. Set PREMIUM_ENABLED=true.
# ---------------------------------------------------------------------------
# Midtrans Snap. Server key is a secret: backend only, never in the repo or the browser.
# Sandbox keys start with SB-Mid-...; production keys only after Midtrans business verification.
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# false = Sandbox (app.sandbox.midtrans.com), true = production.
# MIDTRANS_IS_PRODUCTION=false
# End of the launching promo (ISO 8601, with timezone). Empty or a past date = promo off, normal prices.
# PRICING_LAUNCHING_UNTIL=2026-12-15T23:59:00+07:00
# Master switch for Premium: /premium, landing prices, dashboard card, Vault, Checklist, reminders.
# Keep false until the keys, worker, scheduler and email above are ready.
# PREMIUM_ENABLED=false
# WhatsApp number for the "Tanya lewat WhatsApp" button on /premium (digits only, country code first).
# SUPPORT_WHATSAPP_NUMBER=6289604883024

# ---------------------------------------------------------------------------
# Legal pages (config/legal.php). Shown publicly on /kebijakan-privasi, /syarat-ketentuan,
# /kebijakan-cookie and /kebijakan-pengembalian-dana. Use business addresses only (never a
# personal email or home address). Empty = an [ISI: ...] marker that blocks `legal:check`.
# LEGAL_COMPANY_NAME=
# LEGAL_COMPANY_ADDRESS=
# LEGAL_COMPANY_NIB=
# LEGAL_CONTACT_EMAIL=
# LEGAL_PRIVACY_EMAIL=
# LEGAL_JURISDICTION_CITY=
# LEGAL_SERVER_LOCATION=
# LEGAL_MAIL_PROVIDER=
