APP_NAME=Skular
# Production: APP_ENV=production, APP_DEBUG=false, APP_URL=https://your-domain.example
# Generate APP_KEY once per deployment: php artisan key:generate --show
# Do not rotate APP_KEY on routine deploys; existing encrypted data would become unreadable.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Comma-separated IPs of a reverse proxy/load balancer (or "*" only when the
# origin is unreachable except through that proxy). Leave empty when direct.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Observability (no request bodies, bindings, or mentee content are logged).
PERFORMANCE_LOG_SLOW_REQUESTS=true
PERFORMANCE_SLOW_REQUEST_MS=1000
PERFORMANCE_LOG_SLOW_QUERIES=false
PERFORMANCE_SLOW_QUERY_MS=200

OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=openai/gpt-4.1-mini

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Local development uses SQLite. Production should use MySQL 8+ or PostgreSQL 15+.
# The SQLite file is created by `composer setup`; never point production at it.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=skular
# DB_USERNAME=skular
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true when the site is served over HTTPS, so cookies are never sent in clear text.
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
# Private proofs/practice uploads are written to storage/app/private. Mount that
# directory on persistent storage in production; object storage needs an adapter.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
